# Example only. Copy to local.env (ignored) and set the paths for this machine.
# Environment variables that are already set take precedence over local.env.
# Relative paths resolve from the directory containing local.env.

# Directory holding x86_64-aros-gcc and x86_64-aros-nm for the ABIv11 toolchain.
ZUNEKIT_TOOLCHAIN_ABIV11=""
# ABIv11 SDK root: the directory that contains include/ and lib/.
ZUNEKIT_SDK_ABIV11=""

# Mainline (ABIv1) x86_64: directory with x86_64-aros-gcc, and the SDK root.
ZUNEKIT_TOOLCHAIN_V1=""
ZUNEKIT_SDK_V1=""
# Mainline Raspberry Pi aarch64: the compiler (aarch64-aros-clang), and the SDK root.
ZUNEKIT_CC_PI=""
ZUNEKIT_SDK_PI=""
